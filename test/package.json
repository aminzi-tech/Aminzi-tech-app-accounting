{
  "name": "aminzi-workspace",
  "version": "1.0.0",
  "description": "Sign up / sign in (Google, email, phone) with a per-user workspace copied from a business-type template",
  "main": "server/index.js",
  "scripts": {
    "start": "node --disable-warning=ExperimentalWarning server/index.js",
    "dev": "node --watch --disable-warning=ExperimentalWarning server/index.js",
    "test": "node --disable-warning=ExperimentalWarning --test test/flows.test.js",
    "keys": "node scripts/generate-keys.js",
    "check-types": "node scripts/check-business-types.js"
  },
  "license": "UNLICENSED",
  "dependencies": {
    "cookie-parser": "^1.4.7",
    "express": "^4.22.3",
    "express-rate-limit": "^8.7.0",
    "helmet": "^8.3.0",
    "jose": "^6.2.12",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@fontsource-variable/archivo": "^5.3.0",
    "@fontsource-variable/bricolage-grotesque": "^5.3.0",
    "@fontsource-variable/fraunces": "^5.3.0",
    "@fontsource-variable/instrument-sans": "^5.3.0",
    "@fontsource/ibm-plex-sans": "^5.3.0",
    "@fontsource/ibm-plex-sans-condensed": "^5.3.0",
    "@fontsource/instrument-serif": "^5.3.0",
    "playwright": "^1.63.0"
  },
  "private": true,
  "engines": {
    "node": ">=22.5"
  }
}

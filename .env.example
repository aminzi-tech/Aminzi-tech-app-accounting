# Copy to .env and fill in. Generate the three keys with: npm run keys
NODE_ENV=development
PORT=3000
APP_ORIGIN=http://localhost:3000

# --- Encryption keys (32 random bytes, base64). Required in production. ---
DATA_KEY=
DATA_KEY_ID=k1
# During rotation, keep old keys for decryption only: DATA_KEYS_OLD=k0:base64key
DATA_KEYS_OLD=
INDEX_KEY=
TOKEN_KEY=

# --- Google sign-in (Google Cloud Console → APIs & Services → Credentials → OAuth client ID, type "Web application")
# Authorised redirect URI must be exactly: APP_ORIGIN + /auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Email codes: console (dev) | resend
MAIL_PROVIDER=console
MAIL_FROM=AminZi Tech <no-reply@yourdomain.com>
RESEND_API_KEY=

# --- SMS codes: console (dev) | twilio
SMS_PROVIDER=console
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
# Local numbers starting with 0 get this country code (93 = Afghanistan)
DEFAULT_COUNTRY_CODE=93

# --- Instances
BUSINESS_TYPES_FILE=config/business-types.json
GIT_ALLOWED_HOSTS=github.com,gitlab.com
MAX_TEMPLATE_MB=50
